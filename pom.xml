<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.ward</groupId>
    <artifactId>ward-parent</artifactId>
    <version>0.8.0</version>
    <packaging>pom</packaging>
    <name>ward-parent</name>
    <description>Ward: a quality gate orchestrator for AI coding agents</description>

    <modules>
        <module>ward-analysis-api</module>
        <module>ward-frontend-antlr</module>
        <module>ward-analysis-engine</module>
        <module>ward-lang-jvm</module>
        <module>ward-lang-node</module>
        <module>ward-cli</module>
        <module>ward-lang-python</module>
        <module>ward-lang-swift</module>
        <module>ward-lang-openapi</module>
        <module>ward-analysis-bench</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <picocli.version>4.7.7</picocli.version>
        <tomlj.version>2.2.0</tomlj.version>
        <dagger.version>2.60.1</dagger.version>
        <javax.inject.version>1</javax.inject.version>
        <fory.version>1.7.7</fory.version>
        <native-build-tools.version>1.1.18</native-build-tools.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <!-- Mutate use cases and domain logic; adapters are covered by integration tests. -->
        <pit.targetClasses>dev.ward.domain.*,dev.ward.application.*,dev.ward.analysis.domain.*,dev.ward.analysis.application.*</pit.targetClasses>
        <pit.failWhenNoMutations>true</pit.failWhenNoMutations>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Guava arrives through Checkstyle; 33.4.8-jre has a high advisory fixed in 33.7.2. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.8.0-jre</version>
            </dependency>
            <dependency>
                <groupId>com.google.dagger</groupId>
                <artifactId>dagger</artifactId>
                <version>${dagger.version}</version>
            </dependency>
            <dependency>
                <groupId>javax.inject</groupId>
                <artifactId>javax.inject</artifactId>
                <version>${javax.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.tomlj</groupId>
                <artifactId>tomlj</artifactId>
                <version>${tomlj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.fory</groupId>
                <artifactId>fory-json</artifactId>
                <version>${fory.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>1.5.1</version>
            </dependency>
            <dependency>
                <groupId>com.puppycrawl.tools</groupId>
                <artifactId>checkstyle</artifactId>
                <version>10.26.1</version>
            </dependency>
            <dependency>
                <groupId>org.codehaus.plexus</groupId>
                <artifactId>plexus-utils</artifactId>
                <version>3.6.2</version>
            </dependency>
            <dependency>
                <groupId>net.sourceforge.pmd</groupId>
                <artifactId>pmd-java</artifactId>
                <version>7.29.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.maven</groupId>
                <artifactId>maven-model</artifactId>
                <version>3.10.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- Pins the default lifecycle plugins for the build-policy plugin-version-pinned rule. -->
        <pluginManagement>
            <plugins>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.5.0</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.2.0</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-deploy-plugin</artifactId><version>3.2.0</version></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-site-plugin</artifactId><version>3.22.0</version></plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                    <configuration>
                        <!-- One test JVM per core; each class still runs alone in its fork. -->
                        <forkCount>1C</forkCount>
                        <reuseForks>true</reuseForks>
                        <!-- Keeps tests offline: the real wiring would otherwise query GitHub for updates. -->
                        <environmentVariables>
                            <WARD_NO_UPDATE_CHECK>1</WARD_NO_UPDATE_CHECK>
                        </environmentVariables>
                        <!-- Git hooks export these; tests that run git in a temp repo would read this repo instead. -->
                        <excludedEnvironmentVariables>GIT_DIR,GIT_INDEX_FILE,GIT_WORK_TREE,GIT_PREFIX</excludedEnvironmentVariables>
                        <!-- Tests that read repository files outside the module (skills, plugin manifest, compatibility manifest). -->
                        <systemPropertyVariables>
                            <ward.repository.root>${maven.multiModuleProjectDirectory}</ward.repository.root>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.16</version>
                    <executions>
                        <!-- Instruments the test run so the coverage gate measures the current tests. -->
                        <execution>
                            <id>prepare-agent</id>
                            <goals><goal>prepare-agent</goal></goals>
                        </execution>
                    </executions>
                    <configuration>
                        <excludes>
                            <exclude>**/Dagger*</exclude>
                            <exclude>**/*_Factory</exclude>
                            <exclude>**/*_Factory*</exclude>
                            <exclude>**/*_*Factory</exclude>
                            <exclude>**/*Module_*Factory*</exclude>
                            <exclude>**/*Module_*</exclude>
                            <exclude>**/*_MembersInjector</exclude>
                            <exclude>**/*_MembersInjector*</exclude>
                            <exclude>**/*_Proxy</exclude>
                            <exclude>**/*_Proxy*</exclude>
                        </excludes>
                        <!-- Strict preset minimums. -->
                        <rules>
                            <rule>
                                <element>BUNDLE</element>
                                <limits>
                                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
                                </limits>
                            </rule>
                        </rules>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>1.30.0</version>
                                <style>GOOGLE</style>
                            </googleJavaFormat>
                        </java>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>3.6.0</version>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                        <excludeGeneratedSources>true</excludeGeneratedSources>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.28.0</version>
                    <configuration>
                        <excludeRoots>
                            <excludeRoot>${project.build.directory}/generated-sources/annotations</excludeRoot>
                        </excludeRoots>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/config/pmd-ruleset.xml</ruleset>
                        </rulesets>
                        <includeTests>true</includeTests>
                        <!-- Re-analyzes only changed files; the edit hook runs PMD on every edit. -->
                        <analysisCache>true</analysisCache>
                        <failOnViolation>true</failOnViolation>
                        <printFailingErrors>true</printFailingErrors>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.10.5.0</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Medium</threshold>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
                <plugin>
                  <groupId>org.pitest</groupId>
                  <artifactId>pitest-maven</artifactId>
                  <version>1.30.1</version>
                  <dependencies>
                    <dependency>
                      <groupId>org.pitest</groupId>
                      <artifactId>pitest-junit5-plugin</artifactId>
                      <version>1.2.3</version>
                    </dependency>
                  </dependencies>
                  <configuration>
                    <targetClasses>${pit.targetClasses}</targetClasses>
                    <failWhenNoMutations>${pit.failWhenNoMutations}</failWhenNoMutations>
                    <threads>4</threads>
                    <!-- PIT forks its own JVM, so it needs the repository root that Surefire sets. -->
                    <jvmArgs>
                      <jvmArg>-Dward.repository.root=${maven.multiModuleProjectDirectory}</jvmArg>
                    </jvmArgs>
                    <environmentVariables>
                      <WARD_NO_UPDATE_CHECK>1</WARD_NO_UPDATE_CHECK>
                    </environmentVariables>
                    <mutationThreshold>60</mutationThreshold>
                  </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Pull request CI sets PIT_TARGET_CLASSES to the classes the change touches. -->
        <profile>
            <id>pit-changed-classes</id>
            <activation>
                <property>
                    <name>env.PIT_TARGET_CLASSES</name>
                </property>
            </activation>
            <properties>
                <pit.targetClasses>${env.PIT_TARGET_CLASSES}</pit.targetClasses>
                <pit.failWhenNoMutations>false</pit.failWhenNoMutations>
            </properties>
        </profile>
    </profiles>
</project>
