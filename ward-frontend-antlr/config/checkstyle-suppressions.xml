<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  Approved exception (reviewed by the project owner). SyntaxErrorCollector.syntaxError implements
  ANTLR's ANTLRErrorListener.syntaxError, which has six parameters that the interface fixes, so
  the parameter count cannot be reduced. Only the ParameterNumber check is suppressed, and only in
  that file.
-->
<suppressions>
  <suppress checks="ParameterNumber" files="SyntaxErrorCollector\.java"/>
</suppressions>
