#!/bin/sh
cd "$(dirname "$0")"
if [ "$1" = "--version" ]; then
  echo "Apache Maven 3.9.8"
  echo "Java version: 25.0.5, vendor: Eclipse Adoptium, runtime: /opt/jdk"
  exit 0
fi
echo "stub mvnw: $*"
if [ -f FAIL ]; then
  case " $* " in
    *" eslint:check "*)
      cat <<'JSON'
[{"filePath":"src/main/java/App.java","messages":[{"ruleId":"max-len","severity":2,"message":"Line is longer than 100 characters (found 120).","line":3,"column":1}]}]
JSON
      ;;
  esac
  echo "BUILD FAILURE" >&2
  exit 1
fi
