<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.app">
    <application android:allowBackup="false">
        <provider
            android:name=".NotesProvider"
            android:authorities="com.example.notes"
            android:exported="true"
            android:permission="com.example.NOTES" />
        <provider
            android:name=".ReadOnlyProvider"
            android:authorities="com.example.readonly"
            android:exported="true"
            android:readPermission="com.example.READ" />
        <provider
            android:name=".SplitProvider"
            android:authorities="com.example.split"
            android:exported="true"
            android:readPermission="com.example.READ"
            android:writePermission="com.example.WRITE" />
        <provider
            android:name=".PathProvider"
            android:authorities="com.example.path"
            android:exported="true">
            <path-permission android:pathPrefix="/notes" android:readPermission="com.example.READ" />
        </provider>
        <provider
            android:name=".PrivateProvider"
            android:authorities="com.example.private"
            android:exported="false" />
        <provider
            android:name=".DefaultProvider"
            android:authorities="com.example.default" />
    </application>
</manifest>
