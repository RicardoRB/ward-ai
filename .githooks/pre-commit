#!/bin/sh
# Shared hooks of this repository: run `git config core.hooksPath .githooks` once.
# Checks run in parallel, one thread per processor; set WARD_JOBS to override.
: "${WARD_JOBS:=auto}"
export WARD_JOBS

# ward-owned: quality-hooks v1 begin
if ! (
  set --
  while IFS= read -r ward_path; do
    if [ -n "$ward_path" ]; then set -- "$@" "--path=$ward_path"; fi
  done <<WARD_STAGED
$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR --relative)
WARD_STAGED
  ward check --profile pre-commit --format json "$@"
); then
  exit 1
fi
# ward-owned: quality-hooks v1 end
